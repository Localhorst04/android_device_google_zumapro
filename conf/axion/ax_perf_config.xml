<?xml version="1.0" encoding="utf-8"?>
<perf-config>
    <path name="dram_min_freq">/sys/devices/platform/17000010.devfreq_mif/devfreq/17000010.devfreq_mif/min_freq</path>
    <int name="dram_boost_hz">3744000</int>
    <int name="dram_default_hz">0</int>
    <path name="gpu_min_freq">/sys/devices/platform/1f000000.mali/hint_min_freq</path>
    <path name="gpu_freqs">/sys/devices/platform/1f000000.mali/available_frequencies</path>

    <hint name="launch">
        <res name="cpu_min_c0">-1</res>
        <res name="cpu_min_c1">-1</res>
        <res name="cpu_min_c2">-1</res>
        <res name="cpu_max_c0">1</res>
        <res name="cpu_max_c1">1</res>
        <res name="cpu_max_c2">1</res>
        <res name="gpu_max">1</res>
        <res name="dram_min">-1</res>
        <res name="cpuset_svp">1</res>
        <res name="uclamp_fg">70</res>
        <res name="uclamp_top">70</res>
        <res name="rr_fling">1</res>
        <int name="duration_ms">500</int>
    </hint>

    <hint name="fling">
        <res name="cpu_min_c1">-1</res>
        <res name="cpu_min_c2">-1</res>
        <res name="uclamp_fg">50</res>
        <res name="rr_fling">1</res>
    </hint>

    <hint name="shade">
        <res name="cpuset_svp">1</res>
        <res name="cpuset_sysui">1</res>
        <res name="cpuset_top">1</res>
        <res name="gpu_boost">1</res>
        <res name="dram_min">-1</res>
        <res name="uclamp_fg">50</res>
        <res name="uclamp_top">50</res>
    </hint>

    <hint name="gpu">
        <res name="gpu_boost">1</res>
    </hint>

    <hint name="game">
        <res name="gpu_max">1</res>
        <res name="dram_min">-1</res>
        <res name="uclamp_top">70</res>
    </hint>

    <hint name="scroll_input">
        <res name="cpu_min_c0">-1</res>
        <int name="duration_ms">300</int>
    </hint>

    <hint name="scroll_prefiling">
        <res name="cpu_min_c0">-1</res>
        <res name="dram_min">-1</res>
        <int name="duration_ms">300</int>
    </hint>

    <hint name="scroll_vertical">
        <res name="cpu_min_c0">-1</res>
        <int name="duration_ms">300</int>
    </hint>

    <hint name="scroll_scroller">
        <res name="cpu_min_c0">-1</res>
        <res name="gpu_boost">1</res>
        <int name="duration_ms">300</int>
    </hint>

    <hint name="frame_prefetcher">
        <res name="dram_min">-1</res>
        <int name="duration_ms">100</int>
    </hint>

    <hint name="frame_real_draw">
        <res name="gpu_boost">1</res>
        <int name="duration_ms">100</int>
    </hint>

    <hint name="frame_obtain_view">
        <res name="cpu_min_c0">-1</res>
        <int name="duration_ms">100</int>
    </hint>

    <hint name="frame_render_info">
        <res name="cpu_min_c0">-1</res>
        <int name="duration_ms">100</int>
    </hint>

    <hint name="ime_show_hide">
        <res name="cpu_min_c0">-1</res>
        <int name="duration_ms">200</int>
    </hint>

    <hint name="ime_init">
        <res name="cpu_min_c0">-1</res>
        <res name="dram_min">-1</res>
        <int name="duration_ms">200</int>
    </hint>
</perf-config>
