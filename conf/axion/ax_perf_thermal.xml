<?xml version="1.0" encoding="utf-8"?>
<perf-config>
    <atmc>
        <cpu_levels>
            <!-- LEVEL 1-3: Peak Performance (Kaum Drosselung, nur Spitzen kappen) -->
            <level id="1" little="1950000" big="2600000" prime="3100000"/> <!-- Stock Max -->
            <level id="2" little="1950000" big="2450000" prime="2850000"/> 
            <level id="3" little="1800000" big="2350000" prime="2600000"/> 

            <!-- LEVEL 4-7: Der "Sustained" Bereich (Hier soll das Handy unter Last verweilen) -->
            <level id="4" little="1800000" big="2100000" prime="2400000"/>
            <level id="5" little="1700000" big="1950000" prime="2200000"/>
            <level id="6" little="1550000" big="1800000" prime="2100000"/>
            <level id="7" little="1550000" big="1550000" prime="1950000"/>

            <!-- LEVEL 8-11: Harte Drosselung (Wenn das Gerät in der Sonne liegt oder kocht) -->
            <level id="8" little="1400000" big="1400000" prime="1700000"/>
            <level id="9" little="1300000" big="1300000" prime="1500000"/>
            <level id="10" little="1100000" big="1100000" prime="1300000"/>
            <level id="11" little="900000"  big="900000"  prime="1100000"/>
        </cpu_levels>
            <!-- TODO: redo table and redefine values more thoughtfully -->
        <gpu_levels>
            <level id="1" min="649000" max="649000"/>
            <level id="2" min="580000" max="580000"/>
            <level id="3" min="521000" max="521000"/>
            <level id="4" min="467000" max="467000"/>
            <level id="5" min="419000" max="419000"/>
            <level id="6" min="376000" max="376000"/>
            <level id="7" min="302000" max="302000"/>
            <level id="8" min="150000" max="150000"/>
        </gpu_levels>
        <scenes>
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="7"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="8"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="9"/>
                    <action unit="gpu" status="8"/>
                    <action unit="bg_killer" status="4"/>
                </level>
            </scene>
            <scene name="game">
                <level id="5">
                    <action unit="cpu" status="3"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="11">
                    <action unit="gpu" status="6"/>
                    <action unit="cpu" status="7"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="7"/>
                    <action unit="cpu" status="8"/>
                </level>
            </scene>
            <scene name="heating_fgs">
                <level id="5">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="9"/>
                </level>
                <level id="10">
                    <action unit="gpu" status="8"/>
                    <action unit="cpu" status="11"/>
                </level>
            </scene>
            <scene name="axcamera_photo_preview">
                <level id="9">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="7"/>
                </level>
            </scene>
        </scenes>
        <apps>
            <app pkgs="com.instagram.android,com.whatsApp,com.snapchat.android,us.zoom.videomeetings,com.microsoft.teams">
                <level id="4">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="6">
                    <action unit="cpu" status="7"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="8"/>
                </level>
            </app>
            <app pkgs="com.google.android.apps.maps,com.waze">
                <level id="7">
                    <action unit="cpu" status="4"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="7"/>
                </level>
            </app>
            <app pkgs="com.HoYoverse.hkrpgoversea,com.miHoYo.Yuanshen,com.miHoYo.GenshinImpact,com.supercell.clashroyale">
                <level id="5">
                    <action unit="cpu" status="3"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="8"/>
                </level>
            </app>
        </apps>
    </atmc>
</perf-config>